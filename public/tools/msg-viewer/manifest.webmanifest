{
  "id": "/tools/msg-viewer/",
  "name": "MSG Viewer: Open Outlook .msg Files",
  "short_name": "MSG Viewer",
  "description": "Open Outlook .msg emails without Outlook. Read the message and download the attachments free, then save as PDF.",
  "start_url": "/tools/msg-viewer/?source=pwa",
  "scope": "/tools/",
  "display": "standalone",
  "background_color": "#FFFBF3",
  "theme_color": "#22517A",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["productivity", "business", "utilities"],
  "icons": [
    { "src": "/tools/msg-viewer/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/tools/msg-viewer/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/tools/msg-viewer/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "/tools/msg-viewer/?source=file",
      "name": "Outlook email",
      "icons": [{ "src": "/tools/msg-viewer/icons/file-256.png", "sizes": "256x256", "type": "image/png" }],
      "accept": { "application/vnd.ms-outlook": [".msg"] },
      "launch_type": "multiple-clients"
    }
  ],
  "launch_handler": { "client_mode": ["navigate-new", "auto"] }
}
