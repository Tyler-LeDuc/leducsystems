{
  "id": "/tools/access-viewer/",
  "name": "Access Viewer: Open Access Databases",
  "short_name": "Access Viewer",
  "description": "Open Microsoft Access .mdb and .accdb databases without Access. See every table free, then export to Excel and CSV.",
  "start_url": "/tools/access-viewer/?source=pwa",
  "scope": "/tools/",
  "display": "standalone",
  "background_color": "#FFFBF3",
  "theme_color": "#5B1F2E",
  "lang": "en-US",
  "dir": "ltr",
  "categories": [
    "productivity",
    "business",
    "utilities"
  ],
  "icons": [
    {
      "src": "/tools/access-viewer/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/tools/access-viewer/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/tools/access-viewer/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/tools/access-viewer/?source=file",
      "name": "Microsoft Access database",
      "icons": [
        {
          "src": "/tools/access-viewer/icons/file-256.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ],
      "accept": {
        "application/x-msaccess": [
          ".mdb",
          ".accdb"
        ]
      },
      "launch_type": "multiple-clients"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-new",
      "auto"
    ]
  }
}
