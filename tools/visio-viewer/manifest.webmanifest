{
  "id": "/tools/visio-viewer/",
  "name": "Visio Viewer: Open VSD and VSDX Files",
  "short_name": "Visio Viewer",
  "description": "Open Visio .vsdx and .vsd drawings without Visio. See every page free, then download PDF and PNG.",
  "start_url": "/tools/visio-viewer/?source=pwa",
  "scope": "/tools/",
  "display": "standalone",
  "background_color": "#FFFBF3",
  "theme_color": "#22325A",
  "lang": "en-US",
  "dir": "ltr",
  "categories": [
    "productivity",
    "business",
    "utilities"
  ],
  "icons": [
    {
      "src": "/tools/visio-viewer/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/tools/visio-viewer/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/tools/visio-viewer/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/tools/visio-viewer/?source=file",
      "name": "Visio drawing",
      "icons": [
        {
          "src": "/tools/visio-viewer/icons/file-256.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ],
      "accept": {
        "application/vnd.ms-visio.drawing": [
          ".vsdx"
        ],
        "application/vnd.ms-visio.drawing.macroEnabled.12": [
          ".vsdm"
        ],
        "application/vnd.visio": [
          ".vsd"
        ]
      },
      "launch_type": "multiple-clients"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-new",
      "auto"
    ]
  }
}
