{
  "id": "/tools/pages-viewer/",
  "name": "Doc Opener for .pages Files: Word and PDF",
  "short_name": "Doc Opener",
  "description": "Open .pages documents on Windows, Android or Chromebook without a Mac. See every page free, then download Word and PDF.",
  "start_url": "/tools/pages-viewer/?source=pwa",
  "scope": "/tools/",
  "display": "standalone",
  "background_color": "#FFFBF3",
  "theme_color": "#1F5E5B",
  "lang": "en-US",
  "dir": "ltr",
  "categories": [
    "productivity",
    "business",
    "utilities"
  ],
  "icons": [
    {
      "src": "/tools/pages-viewer/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/tools/pages-viewer/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/tools/pages-viewer/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/tools/pages-viewer/?source=file",
      "name": "Pages document",
      "icons": [
        {
          "src": "/tools/pages-viewer/icons/file-256.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ],
      "accept": {
        "application/vnd.apple.pages": [
          ".pages"
        ]
      },
      "launch_type": "multiple-clients"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-new",
      "auto"
    ]
  }
}