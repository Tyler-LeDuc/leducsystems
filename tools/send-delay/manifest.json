{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "5a95d227-0bd2-430e-b972-aa3d091bf1c6",
  "localizationInfo": { "defaultLanguageTag": "en-us" },
  "developer": {
    "name": "LeDuc Systems LLC",
    "websiteUrl": "https://leducsystems.com",
    "privacyUrl": "https://leducsystems.com/tools/send-delay/privacy.html",
    "termsOfUseUrl": "https://leducsystems.com/tools/send-delay/support.html"
  },
  "name": { "short": "Send Delay", "full": "Send Delay for Outlook" },
  "description": {
    "short": "Hold every message you send for a few minutes in new Outlook.",
    "full": "Holds every message you send for a few minutes, like the classic defer delivery rule, with business hours and send-right-away exceptions."
  },
  "icons": { "outline": "assets/outline.png", "color": "assets/color.png" },
  "accentColor": "#1D1B26",
  "validDomains": ["leducsystems.com"],
  "authorization": {
    "permissions": {
      "resourceSpecific": [{ "name": "MailboxItem.ReadWrite.User", "type": "Delegated" }]
    }
  },
  "extensions": [
    {
      "requirements": {
        "scopes": ["mail"],
        "capabilities": [{ "name": "Mailbox", "minVersion": "1.13" }]
      },
      "runtimes": [
        {
          "id": "TaskPaneRuntime",
          "type": "general",
          "code": { "page": "https://leducsystems.com/tools/send-delay/taskpane.html" },
          "lifetime": "short",
          "actions": [{ "id": "OpenPane", "type": "openPage", "pinnable": false }]
        },
        {
          "id": "CommandsRuntime",
          "type": "general",
          "code": { "page": "https://leducsystems.com/tools/send-delay/commands.html", "script": "https://leducsystems.com/tools/send-delay/launchevent.js" },
          "lifetime": "short",
          "actions": [
            { "id": "holdThisMessage", "type": "executeFunction" },
            { "id": "onMessageSendHandler", "type": "executeFunction" },
            { "id": "onMessageComposeHandler", "type": "executeFunction" }
          ]
        }
      ],
      "ribbons": [
        {
          "contexts": ["mailCompose"],
          "tabs": [
            {
              "builtInTabId": "TabDefault",
              "groups": [
                {
                  "id": "sdComposeGroup",
                  "label": "Send Delay",
                  "icons": [
                    { "size": 16, "url": "https://leducsystems.com/tools/send-delay/assets/icon-16.png" },
                    { "size": 32, "url": "https://leducsystems.com/tools/send-delay/assets/icon-32.png" },
                    { "size": 80, "url": "https://leducsystems.com/tools/send-delay/assets/icon-80.png" }
                  ],
                  "controls": [
                    {
                      "id": "sdHoldButton",
                      "type": "button",
                      "label": "Delay this message",
                      "icons": [
                        { "size": 16, "url": "https://leducsystems.com/tools/send-delay/assets/icon-16.png" },
                        { "size": 32, "url": "https://leducsystems.com/tools/send-delay/assets/icon-32.png" },
                        { "size": 80, "url": "https://leducsystems.com/tools/send-delay/assets/icon-80.png" }
                      ],
                      "supertip": {
                        "title": "Delay this message",
                        "description": "Hold this message for your default delay. Press Send afterwards; it waits in Drafts until the time shown."
                      },
                      "actionId": "holdThisMessage"
                    },
                    {
                      "id": "msgComposeOpenPaneButton",
                      "type": "button",
                      "label": "Send Delay",
                      "icons": [
                        { "size": 16, "url": "https://leducsystems.com/tools/send-delay/assets/icon-16.png" },
                        { "size": 32, "url": "https://leducsystems.com/tools/send-delay/assets/icon-32.png" },
                        { "size": 80, "url": "https://leducsystems.com/tools/send-delay/assets/icon-80.png" }
                      ],
                      "supertip": {
                        "title": "Send Delay",
                        "description": "Choose a hold time for this message, or change the rules for every message."
                      },
                      "actionId": "OpenPane"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "contexts": ["mailRead"],
          "tabs": [
            {
              "builtInTabId": "TabDefault",
              "groups": [
                {
                  "id": "sdReadGroup",
                  "label": "Send Delay",
                  "icons": [
                    { "size": 16, "url": "https://leducsystems.com/tools/send-delay/assets/icon-16.png" },
                    { "size": 32, "url": "https://leducsystems.com/tools/send-delay/assets/icon-32.png" },
                    { "size": 80, "url": "https://leducsystems.com/tools/send-delay/assets/icon-80.png" }
                  ],
                  "controls": [
                    {
                      "id": "msgReadOpenPaneButton",
                      "type": "button",
                      "label": "Send Delay rules",
                      "icons": [
                        { "size": 16, "url": "https://leducsystems.com/tools/send-delay/assets/icon-16.png" },
                        { "size": 32, "url": "https://leducsystems.com/tools/send-delay/assets/icon-32.png" },
                        { "size": 80, "url": "https://leducsystems.com/tools/send-delay/assets/icon-80.png" }
                      ],
                      "supertip": {
                        "title": "Send Delay rules",
                        "description": "Change how long Send Delay holds your outgoing mail."
                      },
                      "actionId": "OpenPane"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "autoRunEvents": [
        {
          "requirements": {
            "scopes": ["mail"],
            "capabilities": [{ "name": "Mailbox", "minVersion": "1.13" }]
          },
          "events": [
            { "type": "messageSending", "actionId": "onMessageSendHandler", "options": { "sendMode": "softBlock" } },
            { "type": "messageComposeOpened", "actionId": "onMessageComposeHandler" }
          ]
        }
      ]
    }
  ]
}
